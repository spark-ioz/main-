#include <stdio.h>

int heap[100];
int size = 0;

void insert(int value)
{
    int i, parent;

    size++;
    i = size;

    while (i > 1)
    {
        parent = i / 2;

        if (heap[parent] <= value)
            break;

        heap[i] = heap[parent];
        i = parent;
    }

    heap[i] = value;
}

int deleteMin()
{
    int min, last, i, child;

    min = heap[1];
    last = heap[size];
    size--;

    i = 1;

    while (2 * i <= size)
    {
        child = 2 * i;

        if (child + 1 <= size &&
            heap[child + 1] < heap[child])
        {
            child++;
        }

        if (heap[child] >= last)
            break;

        heap[i] = heap[child];
        i = child;
    }

    heap[i] = last;

    return min;
}

void display()
{
    int i;

    printf("Min-Heap: ");

    for (i = 1; i <= size; i++)
        printf("%d ", heap[i]);

    printf("\n");
}

int main()
{
    insert(25);
    insert(10);
    insert(30);
    insert(5);
    insert(15);

    printf("After insertion:\n");
    display();

    printf("Deleted element: %d\n", deleteMin());

    printf("After deletion:\n");
    display();

    return 0;
}